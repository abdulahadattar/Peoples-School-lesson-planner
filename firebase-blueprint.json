{
  "entities": {
    "MarksheetCache": {
      "title": "MarksheetCache",
      "description": "Cached Google Sheet marksheet metadata or per-exam student score snapshot stored in Firestore.",
      "type": "object",
      "properties": {
        "docType": {
          "type": "string",
          "enum": ["meta", "exam"],
          "description": "Whether the document stores sheet metadata or exam score entries."
        },
        "spreadsheetId": {
          "type": "string",
          "minLength": 10,
          "maxLength": 128,
          "description": "Google Spreadsheet ID this cache entry belongs to."
        },
        "contentHash": {
          "type": "string",
          "maxLength": 128,
          "description": "Deterministic hash of the synced workbook payload for change detection."
        },
        "syncedAt": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO timestamp of when the sheet snapshot was synced."
        },
        "updatedAt": {
          "type": "integer",
          "description": "Epoch milliseconds when the cache document was written."
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 160,
          "description": "Admin email or label that refreshed the cache."
        },
        "examType": {
          "type": "string",
          "enum": ["midterm", "mock", "preboard"],
          "description": "Exam type for exam snapshot documents."
        },
        "count": {
          "type": "integer",
          "description": "Number of unique students in the snapshot."
        },
        "configPatch": {
          "type": "object",
          "description": "Parsed school and max-marks configuration from Basic Information tab."
        },
        "entriesByKey": {
          "type": "object",
          "description": "Map of marksheet entry keys to StudentMarkEntry objects for this exam."
        }
      },
      "required": ["docType", "spreadsheetId", "updatedAt"]
    },
    "MarksheetPendingEdit": {
      "title": "MarksheetPendingEdit",
      "description": "Teacher-edited student marks and optional subject selections stored in Firestore awaiting Admin push to Google Sheets.",
      "type": "object",
      "properties": {
        "docId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Deterministic key matching examType__grNo."
        },
        "grNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Student GR number."
        },
        "studentName": {
          "type": "string",
          "maxLength": 120,
          "description": "Student display name."
        },
        "gradeLevel": {
          "type": "string",
          "enum": ["IX", "X", "XI", "XII"],
          "description": "Student grade level."
        },
        "examType": {
          "type": "string",
          "enum": ["midterm", "mock", "preboard"],
          "description": "Exam type being adjusted."
        },
        "scores": {
          "type": "object",
          "description": "Map of SubjectKey to numeric score, 'A', or null for changed subjects."
        },
        "previousScores": {
          "type": "object",
          "description": "Map of SubjectKey to previous baseline score before pending edit."
        },
        "fieldAuthors": {
          "type": "object",
          "description": "Per-subject author attribution map (name, email, updatedAt)."
        },
        "optionalLanguage": {
          "type": "string",
          "enum": ["Sindhi", "Urdu"],
          "description": "Selected optional language subject."
        },
        "optionalElective": {
          "type": "string",
          "enum": ["Biology", "ICT", "Mathematics"],
          "description": "Selected optional elective subject."
        },
        "updatedAt": {
          "type": "integer",
          "description": "Epoch milliseconds of the latest teacher adjustment."
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the teacher who saved the edit."
        },
        "updatedByEmail": {
          "type": "string",
          "maxLength": 160,
          "description": "Email of the teacher who saved the edit."
        },
        "updatedByName": {
          "type": "string",
          "maxLength": 120,
          "description": "Display name of the teacher who saved the edit."
        }
      },
      "required": ["docId", "grNo", "gradeLevel", "examType", "scores", "updatedAt", "updatedByUid"]
    },
    "ClassroomMcqTest": {
      "title": "ClassroomMcqTest",
      "description": "Classroom weekly or monthly 30-50 MCQ test paper, answer key, and metadata linked to a scannable Test ID.",
      "type": "object",
      "properties": {
        "testCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique Test ID encoded in QR codes on question papers and OMR sheets."
        },
        "savedPaperId": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional linked IndexedDB saved paper ID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "description": "Classroom test title."
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Subject name."
        },
        "classLevel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "description": "Normalized class/grade level (e.g. IX, X, XI, XII)."
        },
        "testFrequency": {
          "type": "string",
          "enum": ["weekly", "monthly"],
          "description": "Classroom test cadence."
        },
        "testNumber": {
          "type": "string",
          "maxLength": 48,
          "description": "Sequence label such as Test #01."
        },
        "testDate": {
          "type": "string",
          "maxLength": 24,
          "description": "ISO date string YYYY-MM-DD."
        },
        "questionCount": {
          "type": "integer",
          "description": "Total MCQ count (typically 30-50)."
        },
        "answerKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-D]+$",
          "description": "Authoritative MCQ answer key string (A-D)."
        },
        "paperSnapshot": {
          "type": "object",
          "description": "Optional serialized question paper sections snapshot for cross-device recall."
        },
        "createdAt": {
          "type": "integer",
          "description": "Epoch milliseconds created."
        },
        "updatedAt": {
          "type": "integer",
          "description": "Epoch milliseconds last updated."
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the teacher who saved the test."
        }
      },
      "required": [
        "testCode",
        "title",
        "subject",
        "classLevel",
        "testFrequency",
        "testNumber",
        "testDate",
        "questionCount",
        "answerKey",
        "createdAt",
        "updatedAt",
        "updatedByUid"
      ]
    },
    "ClassroomOmrResult": {
      "title": "ClassroomOmrResult",
      "description": "Graded student OMR result row linked to a classroom MCQ test.",
      "type": "object",
      "properties": {
        "resultId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Deterministic ID matching testCode__grKey."
        },
        "testCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Linked classroom Test ID."
        },
        "testNumber": {
          "type": "string",
          "maxLength": 48,
          "description": "Test sequence label."
        },
        "testDate": {
          "type": "string",
          "maxLength": 24,
          "description": "Test date YYYY-MM-DD."
        },
        "testFrequency": {
          "type": "string",
          "enum": ["weekly", "monthly"],
          "description": "Classroom test cadence."
        },
        "subject": {
          "type": "string",
          "maxLength": 80,
          "description": "Subject name."
        },
        "classLevel": {
          "type": "string",
          "maxLength": 24,
          "description": "Class level."
        },
        "title": {
          "type": "string",
          "maxLength": 180,
          "description": "Test title."
        },
        "grNo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Student GR number."
        },
        "studentName": {
          "type": "string",
          "maxLength": 120,
          "description": "Verified student name."
        },
        "fatherName": {
          "type": "string",
          "maxLength": 120,
          "description": "Verified father's name."
        },
        "section": {
          "type": "string",
          "maxLength": 24,
          "description": "Class section."
        },
        "score": {
          "type": "integer",
          "description": "Obtained marks."
        },
        "total": {
          "type": "integer",
          "description": "Total MCQ marks."
        },
        "percentage": {
          "type": "number",
          "description": "Score percentage."
        },
        "grade": {
          "type": "string",
          "maxLength": 16,
          "description": "Letter grade."
        },
        "correctCount": {
          "type": "integer",
          "description": "Number of correct answers."
        },
        "wrongCount": {
          "type": "integer",
          "description": "Number of wrong answers."
        },
        "blankCount": {
          "type": "integer",
          "description": "Number of blank answers."
        },
        "multiCount": {
          "type": "integer",
          "description": "Number of multi-marked answers."
        },
        "rawAnswers": {
          "type": "array",
          "description": "Detected or overridden MCQ marks per question."
        },
        "scannedAt": {
          "type": "integer",
          "description": "Epoch milliseconds scanned."
        },
        "scannedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the teacher who recorded the scan."
        }
      },
      "required": [
        "resultId",
        "testCode",
        "testNumber",
        "testDate",
        "testFrequency",
        "subject",
        "classLevel",
        "title",
        "grNo",
        "studentName",
        "score",
        "total",
        "percentage",
        "scannedAt",
        "scannedByUid"
      ]
    }
  },
  "firestore": {
    "/marksheets_cache/{cacheId}": {
      "schema": { "$ref": "#/entities/MarksheetCache" },
      "description": "Cached Google Sheet marksheet metadata and per-exam student scores."
    },
    "/marksheet_pending_edits/{editId}": {
      "schema": { "$ref": "#/entities/MarksheetPendingEdit" },
      "description": "Teacher marksheet adjustments awaiting Admin push to Google Sheets."
    },
    "/classroom_tests/{testCode}": {
      "schema": { "$ref": "#/entities/ClassroomMcqTest" },
      "description": "Classroom weekly/monthly MCQ papers and authoritative answer keys indexed by Test ID."
    },
    "/classroom_omr_results/{resultId}": {
      "schema": { "$ref": "#/entities/ClassroomOmrResult" },
      "description": "Graded classroom OMR student result rows used for class result announcements."
    }
  }
}
