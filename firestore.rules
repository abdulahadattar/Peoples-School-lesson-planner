rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny. Every path below must be opened explicitly and narrowly.
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'abdul7762had@gmail.com' ||
        request.auth.token.email.lower() == 'abdul7762ahad@gmail.com'
      );
    }

    match /test/{testId} {
      allow get: if true;
    }

    match /lessonPlans/{planId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /daily_attendance/{date} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && isValidId(date);
    }

    match /attendanceRecords/{recordId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && isValidId(recordId);
    }

    match /substitutions/{dateKey} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && isValidId(dateKey);
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Pending student-record edits, shared between teachers so an edit made on
    // one device is visible on another until it is pushed to Google Sheets.
    // Deliberately NOT world-readable like daily_attendance/substitutions: these
    // documents carry student names, parent CNICs and B-Form numbers, so a
    // signed-in teacher is the minimum bar.
    //
    // The key is the identity of the pending change: the sheet row number for an
    // edit, or `add-<gr-number>` for a new student. Keying adds on the GR number
    // (rather than something random) is what stops a second pending document being
    // created for a student who is already waiting to be added.
    match /student_record_edits/{rowKey} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(rowKey);
    }

    // ── Document archive durable store (C6) ──────────────────────────────
    // The serverless pipeline WRITES these collections through the Firebase
    // Admin SDK, which by design bypasses security rules — the trusted
    // server process is the only write path. The browser never performs a
    // direct Firestore write on any of them, so client writes stay denied.
    // Reads are re-opened narrowly for signed-in users (same bar as
    // student_record_edits — these documents carry student names, CNICs and
    // B-Form numbers alongside the scans) instead of leaving the catch-all
    // default-deny to hide accidental direct reads.
    // NOTE: flat match blocks on purpose — nested match braces are what the
    // rules parity checker (scripts/test-firestore-rules.mjs) parses.
    match /documentJobs/{jobId} {
      allow get, list: if isSignedIn() && isValidId(jobId);
      allow write: if false;
    }
    match /documentJobs/{jobId}/files/{fileId} {
      allow get, list: if isSignedIn();
      allow write: if false;
    }
    match /documentJobs/{jobId}/files/{fileId}/chunks/{chunkId} {
      allow get, list: if isSignedIn();
      allow write: if false;
    }
    match /documentRecords/{docId} {
      allow get, list: if isSignedIn() && isValidId(docId);
      allow write: if false;
    }
    match /dossiers/{grNo} {
      allow get, list: if isSignedIn() && isValidId(grNo);
      allow write: if false;
    }
    match /dismissedFlags/{flagId} {
      allow get, list: if isSignedIn() && isValidId(flagId);
      allow write: if false;
    }
    match /documentCorrections/{grNo} {
      allow get, list: if isSignedIn() && isValidId(grNo);
      allow write: if false;
    }
  }
}

