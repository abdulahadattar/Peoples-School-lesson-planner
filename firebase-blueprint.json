{
  "entities": {
    "LessonPlan": {
      "title": "LessonPlan",
      "description": "Generated lesson plan record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "objective": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "subject": { "type": "string" },
        "createdAt": { "type": "integer" }
      },
      "required": ["userId", "title"]
    },
    "DailyAttendance": {
      "title": "DailyAttendance",
      "description": "Daily attendance record for school",
      "type": "object",
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "recordedBy": { "type": "string" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["date"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily attendance record for school",
      "type": "object",
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "recordedBy": { "type": "string" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["date"]
    },
    "SchoolEnrollments": {
      "title": "SchoolEnrollments",
      "description": "Official school grade and class enrollments configuration",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "integer" },
        "updatedBy": { "type": "string" },
        "enrollments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "classKey": { "type": "string" },
              "romanName": { "type": "string" },
              "displayName": { "type": "string" },
              "enrolledBoys": { "type": "integer" },
              "enrolledGirls": { "type": "integer" },
              "totalEnrollment": { "type": "integer" }
            },
            "required": ["classKey", "displayName", "enrolledBoys", "enrolledGirls"]
          }
        }
      },
      "required": ["enrollments", "updatedAt"]
    },
    "DailySubstitutions": {
      "title": "DailySubstitutions",
      "description": "Daily teacher substitutions and proxy coverage roster",
      "type": "object",
      "properties": {
        "dateKey": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "absentTeacherIds": { "type": "array" },
        "assignments": { "type": "array" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["dateKey", "absentTeacherIds", "assignments"]
    },
    "SchoolConfig": {
      "title": "SchoolConfig",
      "description": "Master institutional settings, class teachers, enrollment modes, period timings, and Google Sheet edit permissions",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string" },
        "affiliation": { "type": "string" },
        "academicSession": { "type": "string" },
        "principalName": { "type": "string" },
        "enrollmentMode": { "type": "string", "enum": ["manual", "google_sheet"] },
        "sheetEditingEnabled": { "type": "boolean" },
        "sheetEditingLockedMessage": { "type": "string" },
        "classes": { "type": "array" },
        "teachers": { "type": "array" },
        "periods": { "type": "array" },
        "customTimetable": { "type": "array" },
        "timetableNote": { "type": "string" },
        "updatedAt": { "type": "integer" },
        "updatedBy": { "type": "string" }
      },
      "required": ["schoolName", "enrollmentMode", "sheetEditingEnabled", "classes", "periods", "updatedAt"]
    }
  },
  "firestore": {
    "/lessonPlans/{planId}": {
      "schema": { "$ref": "LessonPlan" },
      "description": "User generated lesson plans"
    },
    "/daily_attendance/{date}": {
      "schema": { "$ref": "DailyAttendance" },
      "description": "Daily attendance records"
    },
    "/attendanceRecords/{recordId}": {
      "schema": { "$ref": "AttendanceRecord" },
      "description": "Daily attendance records backup"
    },
    "/substitutions/{dateKey}": {
      "schema": { "$ref": "DailySubstitutions" },
      "description": "Daily teacher substitutions and proxy records"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "SchoolConfig" },
      "description": "School settings including class enrollments, timetable, and sheet permissions"
    }
  }
}

