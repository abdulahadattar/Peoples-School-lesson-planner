rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny. Every path below must be opened explicitly and narrowly.
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'abdul7762had@gmail.com' ||
        request.auth.token.email.lower() == 'abdul7762ahad@gmail.com'
      );
    }

    match /test/{testId} {
      allow get: if true;
    }

    match /lessonPlans/{planId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /daily_attendance/{date} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && isValidId(date);
    }

    match /attendanceRecords/{recordId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && isValidId(recordId);
    }

    match /substitutions/{dateKey} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && isValidId(dateKey);
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Pending student-record edits, shared between teachers so an edit made on
    // one device is visible on another until it is pushed to Google Sheets.
    // Deliberately NOT world-readable like daily_attendance/substitutions: these
    // documents carry student names, parent CNICs and B-Form numbers, so a
    // signed-in teacher is the minimum bar.
    //
    // The key is the identity of the pending change: the sheet row number for an
    // edit, or `add-<gr-number>` for a new student. Keying adds on the GR number
    // (rather than something random) is what stops a second pending document being
    // created for a student who is already waiting to be added.
    match /student_record_edits/{rowKey} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(rowKey);
    }

    // ── Document archive durable store (C6) ──────────────────────────────
    // The serverless pipeline WRITES these collections through the Firebase
    // Admin SDK, which by design bypasses security rules — the trusted
    // server process is the only write path. The browser never performs a
    // direct Firestore write on any of them, so client writes stay denied.
    // Reads are re-opened narrowly for signed-in users (same bar as
    // student_record_edits — these documents carry student names, CNICs and
    // B-Form numbers alongside the scans) instead of leaving the catch-all
    // default-deny to hide accidental direct reads.
    // NOTE: flat match blocks on purpose — nested match braces are what the
    // rules parity checker (scripts/test-firestore-rules.mjs) parses.
    match /documentJobs/{jobId} {
      allow get, list: if isSignedIn() && isValidId(jobId);
      allow write: if false;
    }
    match /documentJobs/{jobId}/files/{fileId} {
      allow get, list: if isSignedIn();
      allow write: if false;
    }
    match /documentJobs/{jobId}/files/{fileId}/chunks/{chunkId} {
      allow get, list: if isSignedIn();
      allow write: if false;
    }
    match /documentRecords/{docId} {
      allow get, list: if isSignedIn() && isValidId(docId);
      allow write: if false;
    }
    match /dossiers/{grNo} {
      allow get, list: if isSignedIn() && isValidId(grNo);
      allow write: if false;
    }
    match /dismissedFlags/{flagId} {
      allow get, list: if isSignedIn() && isValidId(flagId);
      allow write: if false;
    }
    match /documentCorrections/{grNo} {
      allow get, list: if isSignedIn() && isValidId(grNo);
      allow write: if false;
    }

    // ── Marksheets Cache & Pending Teacher Edits ──────────────────────────
    function isValidMarksheetCache(data) {
      return data.keys().hasAll(['docType', 'spreadsheetId', 'updatedAt'])
        && data.keys().hasOnly([
          'docType', 'spreadsheetId', 'contentHash', 'syncedAt',
          'updatedAt', 'updatedBy', 'examType', 'count', 'configPatch', 'entriesByKey'
        ])
        && data.docType is string && data.docType in ['meta', 'exam']
        && data.spreadsheetId is string && data.spreadsheetId.size() >= 10 && data.spreadsheetId.size() <= 128
        && data.updatedAt is int
        && (!('contentHash' in data) || (data.contentHash is string && data.contentHash.size() <= 128))
        && (!('syncedAt' in data) || (data.syncedAt is string && data.syncedAt.size() <= 64))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 160))
        && (!('examType' in data) || (data.examType is string && data.examType in ['midterm', 'mock', 'preboard']))
        && (!('count' in data) || data.count is int)
        && (!('configPatch' in data) || data.configPatch == null || data.configPatch is map)
        && (!('entriesByKey' in data) || data.entriesByKey is map);
    }

    function isValidMarksheetPendingEdit(data, editId) {
      return data.keys().hasAll(['docId', 'grNo', 'gradeLevel', 'examType', 'scores', 'updatedAt', 'updatedByUid'])
        && data.keys().hasOnly([
          'docId', 'grNo', 'studentName', 'gradeLevel', 'examType',
          'scores', 'previousScores', 'fieldAuthors', 'optionalLanguage', 'optionalElective',
          'updatedAt', 'updatedByUid', 'updatedByEmail', 'updatedByName'
        ])
        && data.docId is string && data.docId == editId
        && data.grNo is string && data.grNo.size() >= 1 && data.grNo.size() <= 32
        && data.gradeLevel is string && data.gradeLevel in ['IX', 'X', 'XI', 'XII']
        && data.examType is string && data.examType in ['midterm', 'mock', 'preboard']
        && data.scores is map && data.scores.size() <= 16
        && (!('previousScores' in data) || (data.previousScores is map && data.previousScores.size() <= 16))
        && (!('fieldAuthors' in data) || (data.fieldAuthors is map && data.fieldAuthors.size() <= 16))
        && data.updatedAt is int
        && data.updatedByUid is string && (data.updatedByUid == request.auth.uid || isAdmin())
        && (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 120))
        && (!('optionalLanguage' in data) || (data.optionalLanguage is string && data.optionalLanguage in ['Sindhi', 'Urdu']))
        && (!('optionalElective' in data) || (data.optionalElective is string && data.optionalElective in ['Biology', 'ICT', 'Mathematics']))
        && (!('updatedByEmail' in data) || (data.updatedByEmail is string && data.updatedByEmail.size() <= 160))
        && (!('updatedByName' in data) || (data.updatedByName is string && data.updatedByName.size() <= 120));
    }

    match /marksheets_cache/{cacheId} {
      allow get, list: if true;
      allow create, update: if isAdmin() && isValidId(cacheId) && isValidMarksheetCache(request.resource.data);
      allow delete: if isAdmin() && isValidId(cacheId);
    }

    match /marksheet_pending_edits/{editId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(editId) && isValidMarksheetPendingEdit(request.resource.data, editId);
      allow delete: if isValidId(editId) && (isAdmin() || (isSignedIn() && resource.data.updatedByUid == request.auth.uid));
    }

    // ── Classroom MCQ Tests & OMR Results (Separate from Marksheets) ─────
    function isValidClassroomMcqTest(data, testCode) {
      return data.keys().hasAll([
          'testCode', 'title', 'subject', 'classLevel', 'testFrequency',
          'testNumber', 'testDate', 'questionCount', 'answerKey',
          'createdAt', 'updatedAt', 'updatedByUid'
        ])
        && data.keys().hasOnly([
          'testCode', 'savedPaperId', 'title', 'subject', 'classLevel', 'testFrequency',
          'testNumber', 'testDate', 'questionCount', 'answerKey', 'paperSnapshot',
          'createdAt', 'updatedAt', 'updatedByUid'
        ])
        && data.testCode is string && data.testCode == testCode && isValidId(data.testCode)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 80
        && data.classLevel is string && data.classLevel.size() >= 1 && data.classLevel.size() <= 24
        && data.testFrequency is string && data.testFrequency in ['weekly', 'monthly']
        && data.testNumber is string && data.testNumber.size() <= 48
        && data.testDate is string && data.testDate.size() <= 24
        && data.questionCount is int && data.questionCount >= 1 && data.questionCount <= 100
        && data.answerKey is string && data.answerKey.size() >= 1 && data.answerKey.size() <= 100 && data.answerKey.matches('^[A-D]+$')
        && data.createdAt is int
        && data.updatedAt is int
        && data.updatedByUid is string && (data.updatedByUid == request.auth.uid || isAdmin())
        && (!('savedPaperId' in data) || (data.savedPaperId is string && data.savedPaperId.size() <= 120))
        && (!('paperSnapshot' in data) || data.paperSnapshot == null || data.paperSnapshot is map);
    }

    function isValidClassroomOmrResult(data, resultId) {
      return data.keys().hasAll([
          'resultId', 'testCode', 'testNumber', 'testDate', 'testFrequency',
          'subject', 'classLevel', 'title', 'grNo', 'studentName',
          'score', 'total', 'percentage', 'scannedAt', 'scannedByUid'
        ])
        && data.keys().hasOnly([
          'resultId', 'testCode', 'testNumber', 'testDate', 'testFrequency',
          'subject', 'classLevel', 'title', 'grNo', 'studentName', 'fatherName', 'section',
          'score', 'total', 'percentage', 'grade',
          'correctCount', 'wrongCount', 'blankCount', 'multiCount', 'rawAnswers',
          'scannedAt', 'scannedByUid'
        ])
        && data.resultId is string && data.resultId == resultId && isValidId(data.resultId)
        && data.testCode is string && isValidId(data.testCode) && data.testCode.size() <= 48
        && data.testNumber is string && data.testNumber.size() <= 48
        && data.testDate is string && data.testDate.size() <= 24
        && data.testFrequency is string && data.testFrequency in ['weekly', 'monthly']
        && data.subject is string && data.subject.size() <= 80
        && data.classLevel is string && data.classLevel.size() <= 24
        && data.title is string && data.title.size() <= 180
        && data.grNo is string && data.grNo.size() >= 1 && data.grNo.size() <= 32
        && data.studentName is string && data.studentName.size() <= 120
        && data.score is int && data.score >= 0 && data.score <= 100
        && data.total is int && data.total >= 1 && data.total <= 100
        && (data.percentage is int || data.percentage is float)
        && data.scannedAt is int
        && data.scannedByUid is string && (data.scannedByUid == request.auth.uid || isAdmin())
        && (!('fatherName' in data) || (data.fatherName is string && data.fatherName.size() <= 120))
        && (!('section' in data) || (data.section is string && data.section.size() <= 24))
        && (!('grade' in data) || (data.grade is string && data.grade.size() <= 16))
        && (!('correctCount' in data) || data.correctCount is int)
        && (!('wrongCount' in data) || data.wrongCount is int)
        && (!('blankCount' in data) || data.blankCount is int)
        && (!('multiCount' in data) || data.multiCount is int)
        && (!('rawAnswers' in data) || (data.rawAnswers is list && data.rawAnswers.size() <= 100));
    }

    match /classroom_tests/{testCode} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && isValidId(testCode) && isValidClassroomMcqTest(request.resource.data, testCode);
      allow delete: if isValidId(testCode) && (isAdmin() || (isSignedIn() && resource.data.updatedByUid == request.auth.uid));
    }

    match /classroom_omr_results/{resultId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && isValidId(resultId) && isValidClassroomOmrResult(request.resource.data, resultId);
      allow delete: if isValidId(resultId) && (isAdmin() || (isSignedIn() && resource.data.scannedByUid == request.auth.uid));
    }
  }
}
