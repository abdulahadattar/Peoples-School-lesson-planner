GEMINI_API_KEY=
VITE_API_KEY=

# --- Autonoma integration -------------------------------------------------
# Both are required or every signed request is answered with
# 401 "Invalid HMAC signature" (code: INVALID_SIGNATURE).
# Never commit real values; keep them in .env / Vercel project settings.
AUTONOMA_SHARED_SECRET=
AUTONOMA_SIGNING_SECRET=

