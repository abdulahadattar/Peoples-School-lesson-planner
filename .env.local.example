# Local Gemini API key(s) for lesson plan generation.
# Do NOT commit this file to Git.
#
# Single key:
#   VITE_API_KEY=your_gemini_api_key_here
#
# Multiple keys for round-robin rotation (set in Vercel env vars, not here):
#   VITE_API_KEYS=key1,key2,key3,...,key15
#
# You may use either VITE_API_KEY or VITE_API_KEYS (both are supported).
VITE_API_KEY=your_gemini_api_key_here
