{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "dist/server.cjs": {
      "maxDuration": 60,
      "runtime": "nodejs22.x"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/dist/server.cjs" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "cleanUrls": true
}